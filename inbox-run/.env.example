# Copy to .env and fill in. Nothing here is committed — .env is gitignored.

# One secret key. Dashboard -> API keys. Grants whatever its scope allows,
# so rotate it when you are done demoing.
ONE_SECRET=

# TypeSafe key, from console.typesafe.ai -> keys.
TYPESAFE_API_KEY=

# Connection keys from One. These are One's handles for a connection, not
# provider tokens — the Gmail OAuth token never reaches this code.
# `one --agent list` prints them, or copy from the One dashboard.
# Gmail is required. The run skips any of the other three that are missing.
GMAIL_KEY=
SLACK_KEY=
SHEETS_KEY=
HUBSPOT_KEY=

# Where the summary is posted. Defaults to #general.
SLACK_CHANNEL=

# How many conversations `node fetch-batch.js` pulls per batch. Defaults to 5000.
BATCH_SIZE=
